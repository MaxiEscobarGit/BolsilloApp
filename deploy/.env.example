# Copiar a deploy/.env (gitignoreado) y completar. Nunca subir el .env.
DOMAIN=
ACME_EMAIL=

# Imagen de la API (la publica el CI en GHCR). Ej: ghcr.io/tu-usuario/bolsillo-api
API_IMAGE=
API_TAG=latest

POSTGRES_DB=finanzas
POSTGRES_USER=bolsillo
# usar solo letras y numeros (backup.sh hace source del .env)
POSTGRES_PASSWORD=

JWT_SECRET=
ANTHROPIC_API_KEY=

# Origen(es) web permitidos por CORS, ej: https://tudominio.com
CORS_ALLOWED_ORIGINS=

# Backups (backup.sh)
AGE_RECIPIENT=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
