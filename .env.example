# ─── Docker ───────────────────────────────

# PostgreSQL
DB_PASSWORD=

# pgAdmin
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# API en Docker (solo si usás --profile api; vacío = default de desarrollo)
JWT_SECRET=
ANTHROPIC_API_KEY=
# Proveedor de IA: anthropic (default) | gemini (plan gratis, solo para pruebas: Google puede usar los datos para entrenar)
AI_PROVIDER=
GEMINI_API_KEY=
