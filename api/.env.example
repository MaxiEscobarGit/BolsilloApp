# ─── Spring Boot ──────────────────────────
# Perfil: dev (default, con valores locales por defecto) | prod (sin defaults; falla si falta algo)
# En Railway: SPRING_PROFILES_ACTIVE=prod
SPRING_PROFILES_ACTIVE=dev

# Base de datos (obligatorias en prod)
DATABASE_URL=jdbc:postgresql://localhost:5432/finanzas_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=

# JWT — Base64, minimo 256 bits; la app no arranca con uno mas corto (obligatoria en prod)
# Generalo con: openssl rand -base64 32
JWT_SECRET=

# Anthropic (obligatoria en prod)
ANTHROPIC_API_KEY=sk-ant-

# CORS — origenes web permitidos, separados por coma (dev: http://localhost:3000,http://localhost:8081)
CORS_ALLOWED_ORIGINS=
